# Dot-prefixed tooling and config (agents, IDE, OS, etc.)
.*
!.gitignore
!.gitattributes

# ESP-IDF Build System
build/
sdkconfig
sdkconfig.old
.config.old

# Dependencies
dependencies.lock
managed_components/

# Editor/OS clutter (non-dot variants)
*.swp
*.swo
*~
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Backup files
*.bak
*.backup

# Flash download tool files
*.bin
*.elf
*.map

# Keep these important files
!CMakeLists.txt
!main/CMakeLists.txt
!main/*.c
!main/*.h
!main/*.cpp
!main/*.hpp
!components/*/CMakeLists.txt
!components/*/*.c
!components/*/*.h
!components/*/*.cpp
!components/*/*.hpp
!sdkconfig.defaults
!partitions.csv
